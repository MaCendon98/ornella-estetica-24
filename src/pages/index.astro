---
import Layout from '../components/Layout.astro';
import pdfFile from '../images/Preisliste-2025.pdf';
import headerImg from '../images/hero_image.jpg';
const headerImgSrc = headerImg.src;
import portraitImg from '../images/portrait.jpg';
const portraitImgSrc = portraitImg.src;

import '../styles/style.css';



---

<Layout title="Ornella estetica">
  <div>

    <section class="hero-section">
      <div class="hero-bg">
        <div class="hero-wrapper">
          <div class="hero-left">
            <h1 class="hero-title">
              Ganzheitliche<br />
              Hautgesundheit<br />
              &amp; Anti Aging
            </h1>
            <p class="hero-desc">
              Dein Kosmetikstudio in Hannover List. Hier erwarten dich kompetente Hautberatung, ein entspanntes Ambiente und individuell abgestimmte Behandlungen für eine strahlend schöne Haut.
            </p>
            <p class="hero-desc">
              Ich freue mich auf Deinen Besuch!
            </p>
          </div>
          <div class="hero-right">
            <img src={headerImgSrc} alt="Frau Kosmetikstudio" class="hero-img" />
          </div>
        </div>
      </div>
    </section>


    <!-- Zitat -->
    <section class="citation-bg">
      <div class="content-wrapper">
        <div class="citation-text">
          <h3>Skin is the mirror of your health</h3>
        </div>
      </div>
    </section>


    <!-- Über mich -->
    <section class="about-hero">
      <div class="about-hero__container">
        <div class="about-hero__text">
          <h2>
            Ornella Galati Rando — Mehr als<br />
            30 Jahre Erfahrung
          </h2>
          <p>
            Mit Leidenschaft und einem feinen Gespür für individuelle Bedürfnisse begleite ich seit über drei Jahrzehnten Menschen auf ihrem Weg zu gesunder, strahlender Haut.
          </p>
          <p>
            Für mich bedeutet ganzheitliche Kosmetik weit mehr als Pflege: Es ist die Verbindung von Hautgesundheit, innerem Gleichgewicht und nachhaltigem Wohlbefinden.
          </p>
          <a class="btn btn-outlined" href="https://www.instagram.com/ornellaestetica_?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank" rel="noopener">
            <span class="about-hero__ig-icon" aria-hidden="true">
              <!-- SVG: Instagram minimal icon (ersetzbar) -->
              <svg width="25" height="25" fill="none" viewBox="0 0 32 32">
                <rect width="20" height="20" x="6" y="6" stroke="currentColor" stroke-width="2.2" rx="6"/>
                ircle cx="16" cy="16" r="4.65" stroke="currentColor" strokeke-width="2.2"/>
                ircle cx="21.5" cy="10.5" r="1.25" fillll="currentColor"/>
              </svg>
            </span>
            Zu meinem Instagram Kanal
          </a>
        </div>
        <div class="about-hero__image-wrap">
          <img
            src={portraitImgSrc}
            alt="Ornella Galati"
            class="about-hero__image"
          />
        </div>
      </div>
      <div class="approach-grid">
        <div class="approach-item">
          <img src="../images/icon1.svg" alt="" class="approach-icon" />
          <h3>Ganzheitlich & individuell</h3>
          <p>
            Jede Haut ist einzigartig. Deshalb entwickeln wir gemeinsam ein maßgeschneidertes Konzept, das optimal auf Sie abgestimmt ist — von gezielten Wirkstoffbehandlungen bis hin zu regenerierenden Hautkuren.
          </p>
        </div>
        <div class="approach-item">
          <img src="../images/icon2.svg" alt="" class="approach-icon" />
          <h3>Wissen & Technologie</h3>
          <p>
            Ich kombiniere modernste dermatologische Gerätetechnologie mit fundierter kosmetischer Expertise. So entstehen sichtbare, langfristige Ergebnisse, die weit über den oberflächlichen Effekt hinausgehen.
          </p>
        </div>
        <div class="approach-item">
          <img src="../images/icon3.svg" alt="" class="approach-icon" />
          <h3>Heilpraktisches Know-how</h3>
          <p>
            Dank meiner vierjährigen Ausbildung in der Heilpraxis fließen Erkenntnisse aus Naturheilkunde, Ernährung und Lebensstil ein. Ihr Hautbild wird nicht nur von außen, sondern auch von innen gestärkt.
          </p>
        </div>
        <div class="approach-item">
          <img src="../images/icon4.svg" alt="" class="approach-icon" />
          <h3>Kontinuierliche Weiterbildung</h3>
          <p>
            Mein Anspruch ist es, immer auf dem neuesten Stand der Forschung zu sein. So profitieren Sie von hochwirksamen, zugleich schonenden und medizinisch fundierten Behandlungsmethoden.
          </p>
        </div>
      </div>
      
      <hr class="separator" />

    </section>

    <!-- Behandlungen Section -->
     <section class="treatments-section">

      <div class="treatments-row">
        <div class="treatments-left">
          <div class="treatments-spez">Meine Spezialisierung</div>
          <h2>Dermatude Meta Therapy<sup>®</sup></h2>
          <p>
            Unterstützung der Hautfunktion, Optimierung der Hautstruktur und Rückgewinnung jugendlicher Frische — für alle Hauttypen geeignet.
          </p>
          <p>
            Die Meta Therapy vereint die Vorteile moderner Hautverjüngung, Anti-Aging, intensiver Feuchtigkeitsversorgung und Regeneration in einem ganzheitlichen, vollständig natürlichen und medizinisch-ästhetischen Hautkonzept.
          </p>
        </div>
        <div class="treatments-right">
          <img class="treatments-logo" src="../images/dermatude-logo.svg" alt="Dermatude Logo" />
          <ul class="treatments-bullets">
            <li>
              <span class="treatments-check">✓</span>
              <span>Für alle Hauttypen</span>
            </li>
            <li>
              <span class="treatments-check">✓</span>
              <span>Anti Aging</span>
            </li>
            <li>
              <span class="treatments-check">✓</span>
              <span>Feuchtigkeitsversorgung &amp; Regeneration</span>
            </li>
            <li>
              <span class="treatments-check">✓</span>
              <span>Medizinisch-ästhetisches Hautkonzept</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="treatments-more">
        <div class="treatments-more-title">Weitere Behandlungen</div>
        <div class="treatments-more-list">
          <div class="treatments-more-item">
            <div class="treatments-more-headline">Aqua Derm</div>
            <div class="treatments-more-text">Add a short paragraph. Double click to edit and add your own text.</div>
          </div>
          <div class="treatments-more-item">
            <div class="treatments-more-headline">Hautanalyse Observ</div>
            <div class="treatments-more-text">Add a short paragraph. Double click to edit and add your own text.</div>
          </div>
          <div class="treatments-more-item">
            <div class="treatments-more-headline">Meso Needling</div>
            <div class="treatments-more-text">Add a short paragraph. Double click to edit and add your own text.</div>
          </div>
          <div class="treatments-more-item">
            <div class="treatments-more-headline">Meso Needling</div>
            <div class="treatments-more-text">Add a short paragraph. Double click to edit and add your own text.</div>
          </div>
        </div>
        <div class="treatments-pricelist">
          <a class="btn btn-outlined" href="#preisliste">
            Preisliste <span class="treatments-price-arrow">↓</span>
          </a>
        </div>
      </div>

    </section>

    <!-- Footer -->
    <section class="cta-footer">
      <div class="cta-footer-bg">
        <div class="cta-footer-inner">
          <h2>Jetzt Termin vereinbaren</h2>
          <div class="cta-footer-actions">
            <a href="#kontaktformular" class="btn">Termin vereinbaren</a>
            <a href="https://maps.google.com/?q=Hohenzollernstr.+55,+30161+Hannover" target="_blank" class="btn btn-outlined">
              <span class="cta-btn-icon">
                <!-- SVG Kamera/Ort (optional) -->
                <svg aria-hidden="true" viewBox="0 0 24 24" width="1em" height="1em"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l-4-4-4 4" fill="none" stroke="currentColor" stroke-width="2"/></svg>
              </span>
              Google Maps
            </a>
          </div>
          <div class="cta-footer-contact">
            ornellagalati@web.de<br>
            0172 433 65 45<br>
            Hohenzollernstr. 55, 30161 Hannover
          </div>
          <footer class="cta-footer-meta">
            <a href="#impressum">Impressum</a>
            <span>© 2025 ornella estetica</span>
          </footer>
        </div>
      </div>
    </section>


    
  </div>
</Layout>
