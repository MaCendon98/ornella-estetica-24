---
import Layout from '../components/Layout.astro';
import pdfFile from '../images/Preisliste-2025.pdf';
import headerImg from '../images/hero-image.jpg';
const headerImgSrc = headerImg.src;
import headerDesktopImg from '../images/hero-image-desktop.jpg';
const headerDesktopImgSrc = headerDesktopImg.src;
import portraitImg from '../images/portrait.jpg';
const portraitImgSrc = portraitImg.src;
import roundedSection from '../images/roundedsection.svg';
const roundedSectionSrc = roundedSection.src;
import checkIcon from '../images/check.svg';
const checkIconSrc = checkIcon.src;
import instagramIcon from '../images/instagram.svg';
const instagramIconSrc = instagramIcon.src;
import beautyIcon from '../images/beauty.png';
const beautyIconSrc = beautyIcon.src;
import bookIcon from '../images/book.png';
const bookIconSrc = bookIcon.src;
import plantIcon from '../images/plant.png';
const plantIconSrc = plantIcon.src;
import lampIcon from '../images/lamp.png';
const lampIconSrc = lampIcon.src;


import pricelist from '../images/Preisliste-2025.pdf';

import '../styles/style.css';



---

<Layout title="Ornella estetica">
  <div>

  <section class="hero">
    <div class="hero-inner">

      <img
        src={headerImgSrc}
        alt="Ornella Galati"
        class="hero-image"
      />

      <img
        src={roundedSectionSrc}
        alt="Ornella Galati"
        class="hero-roundedsection"
      />

      <div class="hero-textblock">
        <h1>Ganzheitliche Hautgesundheit & Anti Aging</h1>
        <p>
          Deine Kosmetikerin in Hannover List. Mit Leidenschaft und einem feinen Gespür für individuelle Bedürfnisse begleite ich seit über drei Jahrzehnten Menschen auf ihrem Weg zu gesunder, strahlender Haut.
        </p>
        <p>
          Für mich bedeutet ganzheitliche Kosmetik weit mehr als Pflege: Es ist die Verbindung von Hautgesundheit, innerem Gleichgewicht und nachhaltigem Wohlbefinden.
        </p>
        <p>Ich freue mich auf dich!</p>

        <a href="https://wa.me/message/UQ47ZOU3Y5M5M1" target="_blank" class="btn" rel="noopener">Termin vereinbaren</a>
      </div>
    </div>
  </section>

    <!-- Zitat -->
    <!-- <section class="citation-bg">
      <div class="content-wrapper">
        <div class="citation-text">
          <h3>Skin is the mirror of your health</h3>
        </div>
      </div>
    </section> -->


    <!-- Über mich -->
    <section class="about-hero">
      <div class="about-hero__container">
        <div class="about-hero__text">
          <h2>
            Das sind meine Prinzipien
          </h2>
          <!-- <p>
            Mit Leidenschaft und einem feinen Gespür für individuelle Bedürfnisse begleite ich seit über drei Jahrzehnten Menschen auf ihrem Weg zu gesunder, strahlender Haut.
          </p>
          <p>
            Für mich bedeutet ganzheitliche Kosmetik weit mehr als Pflege: Es ist die Verbindung von Hautgesundheit, innerem Gleichgewicht und nachhaltigem Wohlbefinden.
          </p>
        </div>
        <div class="about-hero__image-wrap">
          <img
            src={portraitImgSrc}
            alt="Ornella Galati"
            class="about-hero__image"
          />
        </div> -->
      </div>
      <div class="approach-grid">
        <div class="approach-item">
          <img src={beautyIconSrc} alt="beauty-icon" class="approach-icon" />
          <h3>Ganzheitlich & individuell</h3>
          <p>
            Maßgeschneiderte Hautkonzepte für individuelle Hautbedürfnisse.
          </p>
        </div>
        <div class="approach-item">
          <img src={lampIconSrc} alt="beauty-icon" class="approach-icon" />
          <h3>Wissen & Technologie</h3>
          <p>
            Moderne Gerätetechnologie mit kosmetischer Expertise für langfristige Ergebnisse.
          </p>
        </div>
        <div class="approach-item">
          <img src={plantIconSrc} alt="beauty-icon" class="approach-icon" />
          <h3>Heilpraktisches Know-how</h3>
          <p>
            Naturheilkunde, Ernährung und Lebensstil stärken die Haut von innen und außen.
          </p>
        </div>
        <div class="approach-item">
          <img src={bookIconSrc} alt="beauty-icon" class="approach-icon" />
          <h3>Kontinuierliche Weiterbildung</h3>
          <p>
            Für hochwirksame, schonende und fundierte Behandlungen.
          </p>
        </div>
      </div>

        <a class="btn btn-outlined" href="https://www.instagram.com/ornella__estetica/" target="_blank" rel="noopener">
          <span class="about-hero__ig-icon" aria-hidden="true">
            <img src={instagramIconSrc} alt="instagram-icon">
          </span>
          Zu meinem Instagram Kanal
        </a>
    
      <!-- <hr class="separator" /> -->

    </section>

    <div class="fullwidth_container">
      <img
        src={portraitImgSrc}
        alt="Ornella Galati"
        class="fullwidth_container-image"
      />
    </div>

    <!-- Behandlungen Section -->
     <section class="treatments-section">

      <div class="treatments-spez">Meine Spezialisierung</div>
      <div class="treatments-row">
        <div class="treatments-left">
          <h2 class="treatments-headline">Dermatude Meta Therapy<sup>®</sup></h2>
          <p>
            Unterstützung der Hautfunktion, Optimierung der Hautstruktur und Rückgewinnung jugendlicher Frische — für alle Hauttypen geeignet.
          </p>
          <p>
            Die Meta Therapy vereint die Vorteile moderner Hautverjüngung, Anti-Aging, intensiver Feuchtigkeitsversorgung und Regeneration in einem ganzheitlichen, vollständig natürlichen und medizinisch-ästhetischen Hautkonzept.
          </p>
        </div>
        <div class="treatments-right">
          <!-- <img class="treatments-logo" src={dermatudeImgSrc} alt="Dermatude Logo" /> -->
          <ul class="treatments-bullets">
            <li>
              <span class="treatments-check"><img src={checkIconSrc} alt="Checkmark"></span>
              <span>Für alle Hauttypen</span>
            </li>
            <li>
              <span class="treatments-check"><img src={checkIconSrc} alt="Checkmark"></span>
              <span>Anti Aging</span>
            </li>
            <li>
              <span class="treatments-check"><img src={checkIconSrc} alt="Checkmark"></span>
              <span>Feuchtigkeitsversorgung &amp; Regeneration</span>
            </li>
            <li>
              <span class="treatments-check"><img src={checkIconSrc} alt="Checkmark"></span>
              <span>Medizinisch-ästhetisches Hautkonzept</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="treatments-more">
        <div class="treatments-more-title">Weitere Behandlungen</div>
        <div class="treatments-more-list">
          <div class="treatments-more-item">
            <div class="treatments-more-headline">Aqua Derm</div>
            <div class="treatments-more-text">Sanfte, wasserbasierte Tiefenreinigung, die die Haut gleichzeitig klärt, exfoliert und intensiv mit Feuchtigkeit versorgt.</div>
          </div>
          <div class="treatments-more-item">
            <div class="treatments-more-headline">Hautanalyse Observ</div>
            <div class="treatments-more-text">Hochpräzise Hautanalyse mit spezieller Licht- und Kameratechnologie, die auch verborgene Hautzustände sichtbar macht.</div>
          </div>
          <div class="treatments-more-item">
            <div class="treatments-more-headline">GLOW BIOPeelX Microneedling</div>
            <div class="treatments-more-text">Natürliches Bio-Microneedling, das die Haut durch Mikrokanäle erneuert und für ein frisches, ebenmäßiges Hautbild sorgt.</div>
          </div>
          <div class="treatments-more-item">
            <div class="treatments-more-headline">Meso Needling</div>
            <div class="treatments-more-text">Minimalinvasive Needling-Behandlung, die Kollagenbildung anregt und Wirkstoffe tief in die Haut einschleust.</div>
          </div>
        </div>
        <div class="treatments-pricelist">
          <a class="btn btn-outlined" href={pricelist} target="_blank">
            Preisliste anschauen
          </a>
        </div>
      </div>

    </section>

    <!-- <div class="fullwidth_container">
      <img
        src={portraitImgSrc}
        alt="Ornella Galati"
        class="fullwidth_container-image"
      />
    </div> -->

    <!-- Footer -->
    <section class="cta-footer">
      <div class="cta-footer-bg">
        <div class="cta-footer-inner">
          <h2>Jetzt Termin vereinbaren</h2>
          <div class="cta-footer-actions">
            <a href="https://wa.me/message/UQ47ZOU3Y5M5M1" target="_blank" class="btn" rel="noopener">Termin vereinbaren</a>
            <a href="https://maps.google.com/?q=Hohenzollernstr.+55,+30161+Hannover" target="_blank" class="btn btn-outlined">
              Google Maps
            </a>
          </div>
          <div class="cta-footer-contact">
            ornellagalati@web.de<br>
            0172 433 65 45<br>
            Hohenzollernstr. 55, 30161 Hannover
          </div>
          <footer class="cta-footer-meta">
            <a href="/impressum">Impressum</a>
            <span>&copy; {new Date().getFullYear()} ornella estetica</span>
          </footer>
        </div>
      </div>
    </section>


    
  </div>
</Layout>
