---
import Layout from '../components/Layout.astro';
import pdfFile from '../images/Preisliste-2025.pdf';
import headerImg from '../images/hero_image.jpg';
const headerImgSrc = headerImg.src;
import portraitImg from '../images/portrait.jpg';
const portraitImgSrc = portraitImg.src;

import '../styles/style.css';



---

<Layout title="Ornella estetica">
  <div>

    <section class="hero-section">
      <div class="hero-bg">
        <div class="hero-wrapper">
          <div class="hero-left">
            <h1 class="hero-title">
              Ganzheitliche<br />
              Hautgesundheit<br />
              &amp; Anti Aging
            </h1>
            <p class="hero-desc">
              Dein Kosmetikstudio in Hannover List. Hier erwarten dich kompetente Hautberatung, ein entspanntes Ambiente und individuell abgestimmte Behandlungen für eine strahlend schöne Haut.
            </p>
            <p class="hero-desc">
              Ich freue mich auf Deinen Besuch!
            </p>
          </div>
          <div class="hero-right">
            <img src={headerImgSrc} alt="Frau Kosmetikstudio" class="hero-img" />
          </div>
        </div>
      </div>
    </section>


    <!-- Zitat -->
    <section class="citation-bg">
      <div class="content-wrapper">
        <div class="citation-text">
          <h3>Skin is the mirror of your health</h3>
        </div>
      </div>
    </section>


    <!-- Über mich -->
    <section class="about-hero">
      <div class="about-hero__container">
        <div class="about-hero__text">
          <h2>
            Ornella Galati Rando — Mehr als<br />
            30 Jahre Erfahrung
          </h2>
          <p>
            Mit Leidenschaft und einem feinen Gespür für individuelle Bedürfnisse begleite ich seit über drei Jahrzehnten Menschen auf ihrem Weg zu gesunder, strahlender Haut.
          </p>
          <p>
            Für mich bedeutet ganzheitliche Kosmetik weit mehr als Pflege: Es ist die Verbindung von Hautgesundheit, innerem Gleichgewicht und nachhaltigem Wohlbefinden.
          </p>
          <a class="btn btn-outlined" href="https://www.instagram.com/ornellaestetica_?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank" rel="noopener">
            <span class="about-hero__ig-icon" aria-hidden="true">
              <!-- SVG: Instagram minimal icon (ersetzbar) -->
              <svg width="25" height="25" fill="none" viewBox="0 0 32 32">
                <rect width="20" height="20" x="6" y="6" stroke="currentColor" stroke-width="2.2" rx="6"/>
                ircle cx="16" cy="16" r="4.65" stroke="currentColor" strokeke-width="2.2"/>
                ircle cx="21.5" cy="10.5" r="1.25" fillll="currentColor"/>
              </svg>
            </span>
            Zu meinem Instagram Kanal
          </a>
        </div>
        <div class="about-hero__image-wrap">
          <img
            src={portraitImgSrc}
            alt="Ornella Galati"
            class="about-hero__image"
          />
        </div>
      </div>
      <div class="approach-grid">
        <div class="approach-item">
          <img src="../images/icon1.svg" alt="" class="approach-icon" />
          <h3>Ganzheitlich & individuell</h3>
          <p>
            Jede Haut ist einzigartig. Deshalb entwickeln wir gemeinsam ein maßgeschneidertes Konzept, das optimal auf Sie abgestimmt ist — von gezielten Wirkstoffbehandlungen bis hin zu regenerierenden Hautkuren.
          </p>
        </div>
        <div class="approach-item">
          <img src="../images/icon2.svg" alt="" class="approach-icon" />
          <h3>Wissen & Technologie</h3>
          <p>
            Ich kombiniere modernste dermatologische Gerätetechnologie mit fundierter kosmetischer Expertise. So entstehen sichtbare, langfristige Ergebnisse, die weit über den oberflächlichen Effekt hinausgehen.
          </p>
        </div>
        <div class="approach-item">
          <img src="../images/icon3.svg" alt="" class="approach-icon" />
          <h3>Heilpraktisches Know-how</h3>
          <p>
            Dank meiner vierjährigen Ausbildung in der Heilpraxis fließen Erkenntnisse aus Naturheilkunde, Ernährung und Lebensstil ein. Ihr Hautbild wird nicht nur von außen, sondern auch von innen gestärkt.
          </p>
        </div>
        <div class="approach-item">
          <img src="../images/icon4.svg" alt="" class="approach-icon" />
          <h3>Kontinuierliche Weiterbildung</h3>
          <p>
            Mein Anspruch ist es, immer auf dem neuesten Stand der Forschung zu sein. So profitieren Sie von hochwirksamen, zugleich schonenden und medizinisch fundierten Behandlungsmethoden.
          </p>
        </div>
      </div>
    </section>


    <!-- Ansatz Section -->



    <!-- Expectations Section -->
    <section class="expectations-bg">
      <div class="content-wrapper">
        <div class="expectations-section">
          <h2 class="spaceTop">Was Sie bei mir erwartet</h2>
          <ul class="expectations-list">
            <li>
              <span class="expectation-text">Individuelle Hautanalyse – präzise, tiefgehend, wissenschaftlich fundiert</span>
            </li>
            <li>
              <span class="expectation-text">Effektive Behandlungskonzepte – abgestimmt auf Hautzustand & Lebensstil</span>
            </li>
            <li>
              <span class="expectation-text">Langfristige Hautgesundheit – statt kurzfristiger Trends</span>
            </li>
            <li>
              <span class="expectation-text">Persönliche Betreuung in entspannter, exklusiver Atmosphäre</span>
            </li>
          </ul>
          <div class="philosophy-quote">
            <p>
              Ich bin überzeugt: <strong>Wahre Schönheit entsteht, wenn Fachwissen, Leidenschaft und Achtsamkeit aufeinandertreffen.</strong>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Kontakt Section -->
    <section class="contact-bg">
      <div class="content-wrapper">
        <div class="contact-section">
          <h2 class="spaceTop">Anschrift & Kontakt</h2>
          <div class="contact-info">
            <div class="contact-item">
              <span class="contact-icon">📍</span>
              <div class="contact-details">
                <a href="https://g.page/bellissima-cosmetics?share" target="_blank" class="contact-link">
                  <span class="contact-label">Adresse</span>
                  <span class="contact-value">Große Pfahlstraße 17 · 30161 Hannover</span>
                </a>
              </div>
            </div>
            
            <div class="contact-item">
              <span class="contact-icon">📞</span>
              <div class="contact-details">
                <a href="tel:+491724336545" class="contact-link">
                  <span class="contact-label">Telefon</span>
                  <span class="contact-value">0172 433 65 45</span>
                </a>
              </div>
            </div>
            
            <div class="contact-item">
              <span class="contact-icon">✉️</span>
              <div class="contact-details">
                <a href="mailto:ornellagalati@web.de" class="contact-link">
                  <span class="contact-label">E-Mail</span>
                  <span class="contact-value">ornellagalati@web.de</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Preisliste & Social Section -->
    <section class="pricing-social-bg">
      <div class="content-wrapper">
        <div class="pricing-section">
          <h2 class="spaceTop">Preisliste</h2>
          <div class="pricing-content">
            <p class="pricing-description">
              Zu meinem Repertoire gehören verschönernde Kosmetik und Verwöhnbehandlungen, die dich und deine Haut zum Strahlen bringen. Schau jetzt in die Preisliste!
            </p>
            <div class="download-wrapper">
              <a href={pdfFile} download="Preisliste-Ornella-estetica.pdf" class="download-btn">
                <span class="download-icon">📄</span>
                <span class="download-text">Preisliste herunterladen</span>
              </a>
            </div>
          </div>
        </div>
        <div class="social-section">
          <div class="instagram-wrapper">
            <a href="https://www.instagram.com/ornella__estetica/" target="_blank" class="instagram-btn">
              <span class="instagram-icon">📸</span>
              <span class="instagram-text">Besuche mich auf Instagram!</span>
              <span class="instagram-arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    
  </div>
</Layout>
